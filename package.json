{
  "name": "project_template_react",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:client": "vite --host --port 3000",
    "dev": "pnpm run dev:client",
    "clean": "node scripts/clean.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "gen:images": "node scripts/gen-image-variants.mjs",
    "build:client": "vite build",
    "build": "pnpm run clean && pnpm run build:client && node prerender.js",
    "doctor": "node scripts/doctor.mjs",
    "check:motion": "node scripts/motion-check.mjs",
    "_comment:verify": "必须写 pnpm run doctor —— 单独写 pnpm doctor 会命中 pnpm 自带的内置 doctor 命令（什么都不检查、直接退出 0），知识一致性这一关会被静默跳过",
    "verify": "pnpm run build && pnpm run doctor && pnpm run check:motion"
  },
  "dependencies": {
    "framer-motion": "^12.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.3.0",
    "sonner": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
