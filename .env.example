# ============================================
# AI 知识助手 - 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# ============================================

# --- SiliconFlow / DeepSeek 配置 ---
# 注册地址: https://cloud.siliconflow.cn/
# 获取 API Key 后填入下方
VITE_AI_API_KEY=your_siliconflow_api_key_here
# 可选模型（默认 DeepSeek-V3，也可用 Qwen、GLM 等）
VITE_AI_MODEL=deepseek-ai/DeepSeek-V3
